# Copy to `.env` next to docker-compose.yml and fill in. NEVER commit the real .env.

# --- required ---
# Random 32+ byte secret for signing session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Postgres password for the bundled db service.
POSTGRES_PASSWORD=
# Optional (have defaults): POSTGRES_USER=oqu  POSTGRES_DB=oqu

# Public URL of the site — REQUIRED. Password-reset links are built from this
# (never from the request Host header, to prevent link poisoning). e.g. https://oqu.kz
APP_URL=

# Number of trusted reverse proxies in front of the app (default 1 = the single
# Caddy hop below). Used to read the real client IP for rate-limiting.
TRUSTED_PROXY_COUNT=1

# --- first owner (created automatically on first boot, then ignored) ---
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Владелец платформы

# --- optional ---
# Host port for the app (default 3000). Published on 127.0.0.1 only — reach it
# through the reverse proxy (Caddy/nginx) that terminates HTTPS, never directly.
APP_PORT=3000

# AI mentor — set ONE to take it out of demo mode (GROQ is free):
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MENTOR_MODEL=

# Email (password reset). Without it, reset links are printed to the app logs.
RESEND_API_KEY=
EMAIL_FROM=OQU <noreply@yourdomain.kz>

# Contacts shown on the site, and where notifications about new leads land.
# Leave blank to keep the defaults compiled into src/lib/contacts.ts.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
# Defaults to BOOTSTRAP_OWNER_EMAIL when unset.
OWNER_EMAIL=

# Max upload size for a lesson video, in MB (default 2048).
MAX_VIDEO_MB=2048

# Disk head-room in MB (default 512). A video upload is refused with a clear
# message instead of filling the last free byte — a full disk stops Postgres
# and the site, not just the upload.
MIN_FREE_DISK_MB=512

# --- backups (scripts/backup.sh, switched on by scripts/install-cron.sh) ---
# Where copies are stored (default /var/backups/oqu).
# OQU_BACKUP_DIR=/var/backups/oqu
# How many database dumps to keep: daily and weekly.
# OQU_KEEP_DAILY=7
# OQU_KEEP_WEEKLY=4
# Same for the video archives — they are big, so fewer copies are kept.
# OQU_KEEP_VIDEO_DAILY=2
# OQU_KEEP_VIDEO_WEEKLY=2
