# Copy to `.env` next to docker-compose.yml and fill in. NEVER commit the real .env.

# --- required ---
# Random 32+ byte secret for signing session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Postgres password for the bundled db service.
POSTGRES_PASSWORD=
# Optional (have defaults): POSTGRES_USER=oqu  POSTGRES_DB=oqu

# Public URL of the site — REQUIRED. Password-reset links are built from this
# (never from the request Host header, to prevent link poisoning). e.g. https://oqu.kz
APP_URL=

# Number of trusted reverse proxies in front of the app (default 1 = the single
# Caddy hop below). Used to read the real client IP for rate-limiting.
TRUSTED_PROXY_COUNT=1

# --- first owner (created automatically on first boot, then ignored) ---
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Владелец платформы

# --- application and email ---
# Host port for the app (default 3000). Published on 127.0.0.1 only — reach it
# through the reverse proxy (Caddy/nginx) that terminates HTTPS, never directly.
APP_PORT=3000

# SMTP email (password reset, requests and access notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=OQU <noreply@yourdomain.kz>
EMAIL_REPLY_TO=

# Public support email and inbox for new-lead notifications.
# Leave blank to keep the defaults compiled into src/lib/contacts.ts.
SUPPORT_EMAIL=
# Defaults to BOOTSTRAP_OWNER_EMAIL when unset.
OWNER_EMAIL=

# --- сведения о продавце и условия возврата (страницы /offer и /refund) ---
# Пока НЕ заполнены обязательные поля (LEGAL_ENTITY_NAME, LEGAL_ID, LEGAL_ADDRESS),
# страниц /offer и /refund просто не существует: они отдают 404, ссылки на них не
# появляются в подвале и в sitemap.xml. Это сделано намеренно — лучше отсутствующая
# страница, чем оферта с выдуманными реквизитами.
#
# Организационно-правовая форма: ИП, ТОО, АО. От неё зависит подпись к номеру
# (ИП → ИИН, ТОО/АО → БИН). Можно не заполнять — тогда подпись будет «БИН/ИИН».
LEGAL_ENTITY_TYPE=
# Название/ФИО как в свидетельстве о регистрации, БЕЗ формы — она подставится сама.
# Схема: LEGAL_ENTITY_TYPE=ТОО и LEGAL_ENTITY_NAME=«Название»  →  «ТОО «Название»»
LEGAL_ENTITY_NAME=
# БИН или ИИН — как в регистрационных документах.
LEGAL_ID=
# Подпись к номеру выше, если нужна своя (по умолчанию считается из формы).
# LEGAL_ID_LABEL=
# Юридический адрес одной строкой (город, улица, дом, офис).
LEGAL_ADDRESS=
# Телефон и почта для реквизитов, если отличаются от контактов поддержки выше.
# Пустой email — на страницах покажется SUPPORT_EMAIL.
LEGAL_PHONE=
LEGAL_EMAIL=
# Банковские реквизиты. Печатаются только если заполнены ВСЕ ТРИ — неполный счёт
# бесполезен плательщику.
LEGAL_BANK_NAME=
LEGAL_BANK_BIC=
LEGAL_BANK_IBAN=
# Дата редакции документов, строкой: «5 августа 2026 г.». Пусто — строка не выводится.
LEGAL_UPDATED=
# Срок доступа к курсу в месяцах, если он одинаковый для всех курсов (1–120).
# Пусто — на странице оферты будет написано, что срок указан в описании курса.
LEGAL_ACCESS_MONTHS=
# Сколько дней с момента оплаты принимается заявление на возврат (1–365).
# ОБЯЗАТЕЛЬНО для страницы /refund — без этого её не существует.
LEGAL_REFUND_DAYS=
# Сколько процентов курса допустимо пройти, чтобы возврат был возможен (0–100).
# 0 = только если ученик ещё не начал. Пусто — условие про прогресс не показывается.
LEGAL_REFUND_PROGRESS_PERCENT=
# За сколько рабочих дней перечисляются деньги после согласования возврата (1–90).
# Пусто — срок перечисления на странице не обещается.
LEGAL_REFUND_PAYOUT_DAYS=

# Max upload size for a lesson video, in MB (default 2048).
MAX_VIDEO_MB=2048

# Disk head-room in MB (default 512). A video upload is refused with a clear
# message instead of filling the last free byte — a full disk stops Postgres
# and the site, not just the upload.
MIN_FREE_DISK_MB=512

# --- backups (scripts/backup.sh, switched on by scripts/install-cron.sh) ---
# Where copies are stored (default /var/backups/oqu).
# OQU_BACKUP_DIR=/var/backups/oqu
# How many database dumps to keep: daily and weekly.
# OQU_KEEP_DAILY=7
# OQU_KEEP_WEEKLY=4
# Same for the video archives — they are big, so fewer copies are kept.
# OQU_KEEP_VIDEO_DAILY=2
# OQU_KEEP_VIDEO_WEEKLY=2
