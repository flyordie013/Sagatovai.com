# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# Secret for signing session cookies (HMAC). Generate a random 32+ byte value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Postgres connection string (Neon / Supabase / RDS / local Postgres).
# REQUIRED in production — the app refuses to start without it. Leaving it unset
# is allowed only in development, where it falls back to an embedded database
# (PGlite, ./.pglite) that is wiped on redeploy and seeded with demo accounts.
DATABASE_URL=

# Example (local):  postgresql://postgres:postgres@localhost:5432/oqu
# Example (Neon):   postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/oqu?sslmode=require

# ---------------------------------------------------------------------------
# FIRST-TIME PRODUCTION SETUP
# ---------------------------------------------------------------------------
# A freshly migrated production database has NO users at all. Create the owner:
#
#   pnpm db:migrate      # create the tables
#   OWNER_EMAIL=you@example.com OWNER_PASSWORD='<long unique password>' \
#     pnpm db:bootstrap  # create the first superadmin
#
# OWNER_NAME is optional (defaults to "Владелец платформы").

# ---------------------------------------------------------------------------
# EMAIL VIA SMTP (optional in development, required for real notifications)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=OQU <noreply@yourdomain.kz>
EMAIL_REPLY_TO=
SUPPORT_EMAIL=
OWNER_EMAIL=

# ---------------------------------------------------------------------------
# LOCAL DEMO SEED (development only — never runs in production)
# ---------------------------------------------------------------------------
# Override the demo account passwords so they need not live in source control.
# SEED_OWNER_PASSWORD=
# SEED_STUDENT_PASSWORD=
